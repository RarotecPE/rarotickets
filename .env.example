# =============================================================================
# RaroTickets — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores reais do ambiente.
# Os valores abaixo são FICTÍCIOS e servem apenas de referência.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=RaroTickets
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL) --------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/rarotickets
DATABASE_NAME=rarotickets
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Em desenvolvimento é possível subir um PostgreSQL embarcado (npm run dev) —
# jamais use `true` em produção.
DATABASE_EMBEDDED=false
DATABASE_EMBEDDED_PORT=55432
DATABASE_EMBEDDED_USER=postgres
DATABASE_EMBEDDED_PASSWORD=postgres
DATABASE_EMBEDDED_DATABASE=rarotickets
DATABASE_EMBEDDED_DATA_DIR=.pgdata
# Executa migrations + seed automaticamente ao subir a aplicação.
DATABASE_AUTO_MIGRATE=false
DATABASE_AUTO_SEED=false

# --- Sessão / autenticação ---------------------------------------------------
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-caracteres
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=rarotickets_session
# Mantenha `true` em produção (HTTPS). Em desenvolvimento local use `false`.
COOKIE_SECURE=false

# --- PagBank / PagSeguro (API oficial atual) --------------------------------
# Consulte a documentação oficial atual para endpoints, autenticação e status.
PAGBANK_ENV=sandbox
PAGBANK_API_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_TOKEN=SEU_TOKEN_DE_API_AQUI
PAGBANK_WEBHOOK_SIGNATURE_HEADER=x-authenticity-token
PAGBANK_WEBHOOK_SECRET=SEU_SEGREDO_DE_NOTIFICACAO_AQUI
PAGBANK_NOTIFICATION_URL=https://seu-dominio.com.br/api/v1/webhooks/pagbank

# --- Regras financeiras padrão (podem ser sobrescritas por evento) -----------
DEFAULT_SEAT_RESERVATION_MINUTES=15
PAYMENT_RECONCILE_INTERVAL_MINUTES=10
PAYMENT_RECONCILE_WINDOW_HOURS=48
MAX_INSTALLMENTS=12
MIN_INSTALLMENT_CENTS=500

# --- Credenciais (QR Code de check-in) e certificados ------------------------
CREDENTIAL_SECRET=outro-segredo-para-assinar-os-qr-codes-de-credencial
CERTIFICATE_SECRET=segredo-para-assinar-os-codigos-de-validacao-de-certificado
CERTIFICATE_BASE_URL=https://seu-dominio.com.br/certificados
CREDENTIAL_BASE_URL=https://seu-dominio.com.br/credencial

# --- Comunicações (e-mail / WhatsApp) ---------------------------------------
MAIL_PROVIDER=log
MAIL_FROM=nao-responda@rarotickets.com.br
SMTP_URL=
WHATSAPP_PROVIDER=disabled
WHATSAPP_TOKEN=
WHATSAPP_FROM=

# --- Scheduler (expirações automáticas) --------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
