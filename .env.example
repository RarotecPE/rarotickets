# Endereço público deste ambiente; callback registrado no RaroNexus:
# ${APP_BASE_URL}/api/auth/raronexus/callback
APP_BASE_URL=http://localhost:5173

# Credenciais server-side cadastradas para esta aplicação no RaroNexus.
# Não compartilhe o segredo nem use variáveis VITE_* para credenciais.
RARONEXUS_BASE_URL=
RARONEXUS_CLIENT_ID=
RARONEXUS_CLIENT_SECRET=

# Alinhe o tempo do cookie local à política de sessão do RaroNexus.
RARONEXUS_SESSION_COOKIE_MAX_AGE_SECONDS=28800
RARONEXUS_REQUEST_TIMEOUT_MS=5000

# Duração independente para sessões próprias de participantes.
PARTICIPANT_SESSION_COOKIE_MAX_AGE_SECONDS=28800

# Demonstração sintética somente em desenvolvimento local.
# O servidor também bloqueia este modo quando NODE_ENV=production.
DEMO_LOGIN_ENABLED=false

# Diretório de persistência local (eventos e contas de participantes). Use apenas para dados fictícios.
DATA_DIRECTORY=.data
PORT=3001
