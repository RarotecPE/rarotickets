# =============================================================================
# RaroTickets — Configurações de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Origem pública da aplicação (ex.: http://localhost:3000 ou https://tickets.raro.dev)
APP_BASE_URL="http://localhost:3000"
# Ambiente: development | production
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rarotickets"

# -----------------------------------------------------------------------------
# RaroNexus — SSO e Identidade
# -----------------------------------------------------------------------------
# Origem da instância do RaroNexus
RARONEXUS_BASE_URL="http://localhost:3001"
# Client ID desta aplicação cadastrada no RaroNexus
RARONEXUS_CLIENT_ID="rarotickets"
# Segredo do cliente fornecido pelo RaroNexus (NUNCA expor ao client)
RARONEXUS_CLIENT_SECRET="sua-chave-secreta-aqui"

# -----------------------------------------------------------------------------
# PagBank (PagSeguro) — Integração de Pagamentos
# -----------------------------------------------------------------------------
# Ambiente: sandbox | production
PAGBANK_ENV="sandbox"
# URL base da API v4 (sandbox: https://sandbox.api.pagseguro.com | production: https://api.pagseguro.com)
PAGBANK_BASE_URL="https://sandbox.api.pagseguro.com"
# Token de autenticação Bearer da API v4
PAGBANK_TOKEN="seu-token-pagbank"
# Chave pública para o SDK de checkout/popup no frontend (se aplicável)
PAGBANK_PUBLIC_KEY="sua-public-key"
# Chave/assinatura para validar webhooks do PagBank
PAGBANK_WEBHOOK_SECRET="webhook-secret"

# -----------------------------------------------------------------------------
# Sessões e Segurança
# -----------------------------------------------------------------------------
# Segredo para assinar cookies/QR codes/tokens internos (use string aleatória de >=32 bytes)
APP_SESSION_SECRET="gere-uma-chave-aleatoria-forte-aqui-de-32-bytes-ou-mais"
# Duração da sessão em dias
APP_SESSION_DAYS="7"

# -----------------------------------------------------------------------------
# E-mail (notificações transacionais) — Opcional para MVP
# -----------------------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="no-reply@rarotickets.app"
