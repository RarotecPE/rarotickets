# Aplicação
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
# 32+ bytes aleatórios (ex.: openssl rand -base64 48); usados para sessões auxiliares/links de credencial e assinatura do QR.
APP_SECRET_KEY=[GERE_UM_SEGREDO_FORTE_ALEATORIO]
QR_SIGNING_SECRET=[GERE_OUTRO_SEGREDO_FORTE_ALEATORIO]
CRON_SECRET=[SEGREDO_PARA_ROTAS_DE_TAREFAS_AGENDADAS]

# PostgreSQL (obrigatório em produção)
DATABASE_URL=postgres://[USUARIO]:[SENHA]@[HOST]:5432/[BANCO]?sslmode=require

# RaroNexus — SSO central (não há autenticação local)
RARONEXUS_BASE_URL=https://[HOST_DO_RARONEXUS]
RARONEXUS_CLIENT_ID=[CLIENT_ID_CADASTRADO_NO_RARONEXUS]
RARONEXUS_CLIENT_SECRET=[SEGREDO_DO_CLIENTE_NO_RARONEXUS]
# Chaves exatas de data.role.chave emitidas pelo RaroNexus. Chaves não mapeadas são negadas.
RARONEXUS_ROLE_ADMIN=administrador
RARONEXUS_ROLE_EVENT_MANAGER=gerente_evento
RARONEXUS_ROLE_FINANCE=financeiro
RARONEXUS_ROLE_SUPPORT=atendimento
RARONEXUS_ROLE_CHECKIN=checkin
RARONEXUS_ROLE_READONLY=consulta

# PagBank — pagamento real (PAYMENT_GATEWAY=mock|pagbank)
PAYMENT_GATEWAY=mock
PAGBANK_ENV=sandbox
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_TOKEN=[TOKEN_BEARER_DA_API_PAGBANK]
PAGBANK_PUBLIC_KEY=[CHAVE_PUBLICA_DO_CHECKOUT_PAGBANK]
PAGBANK_WEBHOOK_SECRET=[SEGREDO_PARA_VALIDAR_WEBHOOKS_PAGBANK]

# E-mail transacional (outbox assíncrona)
SMTP_HOST=[HOST_SMTP]
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=[USUARIO_SMTP]
SMTP_PASSWORD=[SENHA_SMTP]
SMTP_FROM=RaroTickets <nao-responda@[SEU_DOMINIO]>

# WhatsApp Cloud API (opcional; e-mail permanece como fallback)
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=[ID_DO_NUMERO_META]
WHATSAPP_ACCESS_TOKEN=[TOKEN_DE_ACESSO_META]
WHATSAPP_TEMPLATE_NAME=[NOME_DO_TEMPLATE_DE_NOTIFICACAO_APROVADO]
# Template aprovado com cinco parâmetros: nome, evento, inscrição, link e prazo da convocação.
WHATSAPP_WAITLIST_TEMPLATE_NAME=[NOME_DO_TEMPLATE_DE_CONVOCACAO_APROVADO]
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Armazenamento de arquivos: local em desenvolvimento ou S3 compatível
STORAGE_DRIVER=local
STORAGE_LOCAL_DIRECTORY=.data/uploads
S3_ENDPOINT=[ENDPOINT_S3_OU_VAZIO_PARA_AWS]
S3_REGION=sa-east-1
S3_BUCKET=[NOME_DO_BUCKET]
S3_ACCESS_KEY_ID=[ACCESS_KEY]
S3_SECRET_ACCESS_KEY=[SECRET_KEY]
S3_PUBLIC_BASE_URL=https://[DOMINIO_PUBLICO_DOS_BANNERS]

# Processamento da outbox/expiração de reservas — configure um cron para POST /api/internal/maintenance
